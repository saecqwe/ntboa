rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // By default, deny all reads and writes to all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a user to read their own document
      allow read: if request.auth.uid == userId;

      // Allow a user to update their own document (e.g., profile info), but not change their role
      allow update: if request.auth.uid == userId && request.resource.data.role == resource.data.role;

      // Allow admins to read and write any user document
      allow read, write: if isAdmin();
    }
    
    // Future rules for other collections will go here.
    // For example:
    //
    // match /evaluations/{evaluationId} {
    //   // Allow evaluators to create evaluations
    //   allow create: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'evaluator';
    //
    //   // Allow referees to read their own evaluations
    //   allow read: if resource.data.refereeId == request.auth.uid;
    //
    //   // Allow admins to read all evaluations
    //   allow read: if isAdmin();
    // }
  }
}
