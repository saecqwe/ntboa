rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - uid: string (required on create, equals userId)
    //   - displayName: string (required on evaluator referee create, 1..120 chars; owner-updatable <= 120 chars)
    //   - name: string (optional, owner-updatable <= 120 chars)
    //   - email: string (required on create, 1..254 chars)
    //   - phone: string (optional, owner-updatable <= 40 chars)
    //   - role: string ('admin' | 'evaluator' | 'referee'; evaluator create locked to 'referee')
    //   - status: string ('Active' | 'Disabled'; evaluator create locked to 'Active')
    //   - tier: string (required on referee create, 1..30 chars; admin-managed on update)
    //   - photoURL: string (required '' on evaluator referee create; owner-updatable '' or http(s) URL <= 2048 chars)
    //   - photo: string (optional, owner-updatable '' or http(s) URL <= 2048 chars)
    //   - profilePhotoUrl: string (optional, owner-updatable '' or http(s) URL <= 2048 chars)
    //   - createdAt: timestamp (required == request.time on evaluator referee create)
    //   - updatedAt: timestamp (optional, owner-updatable)
    //   - avgScore, evaluations, evaluationsCount, totalScoreSum: number (0 on evaluator referee create, server-managed)
    //   - suggestedTier: string ('' on evaluator referee create, server-managed)
    //   - evaluationsMade: number (evaluator docs, server-managed)
    //   - assignedReferees: list (optional, evaluator docs)
    //
    // Collection: evaluations
    // Document ID: {evaluationId}
    // Fields:
    //   - evaluatorId: string (required on evaluator create == request.auth.uid, immutable for evaluators)
    //   - refereeId: string (optional, single-official evaluation)
    //   - refereeIds: list (optional, group evaluation)
    //   - isPublished: bool (required == false on evaluator create; optional bool on admin create and admin/evaluator update; required == true for referee reads)
    //   - publishedAt: timestamp | null (optional, set when published or cleared to null when unpublished)
    //   - publishedBy: string | null (optional, UID of publishing actor or null; evaluators cannot spoof another user's UID)
    //   - scores, totalScore, maxScore, tier, comments, groupComment, isGroup, officials, gameDate, location, createdAt, recommendations
    //
    // Collection: assignments
    // Document ID: {assignmentId}
    // Fields: evaluatorId, refereeIds, location, scheduledDate, status, createdAt, completedAt
    //
    // Collection: locations
    // Document ID: {locationId}
    // Fields: name, address, createdAt
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == role) ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEvaluator() {
      return hasRole('evaluator');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Domain validators
    function isValidPhotoUrl(val) {
      return val is string && (
        val == '' ||
        (val.size() <= 2048 && (val.matches('^https://.*') || val.matches('^http://.*')))
      );
    }

    function isValidProfileFieldIfModified(field, maxLen) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]) ||
        (field in request.resource.data &&
         request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidPhotoFieldIfModified(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]) ||
        (field in request.resource.data &&
         isValidPhotoUrl(request.resource.data[field]));
    }

    function isValidOwnerProfileUpdate() {
      let allowedKeys = ['name', 'displayName', 'phone', 'photo', 'photoURL', 'profilePhotoUrl', 'updatedAt'];
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(allowedKeys) &&
             isValidProfileFieldIfModified('name', 120) &&
             isValidProfileFieldIfModified('displayName', 120) &&
             isValidProfileFieldIfModified('phone', 40) &&
             isValidPhotoFieldIfModified('photo') &&
             isValidPhotoFieldIfModified('photoURL') &&
             isValidPhotoFieldIfModified('profilePhotoUrl') &&
             (!affected.hasAny(['updatedAt']) ||
              ('updatedAt' in request.resource.data && request.resource.data.updatedAt is timestamp));
    }

    function isValidEvaluatorCreatedReferee(userId) {
      let data = request.resource.data;
      let expectedFields = [
        'uid',
        'displayName',
        'email',
        'role',
        'tier',
        'photoURL',
        'createdAt',
        'avgScore',
        'evaluations',
        'evaluationsCount',
        'totalScoreSum',
        'status',
        'suggestedTier'
      ];
      return data.keys().hasOnly(expectedFields) &&
             data.keys().hasAll(expectedFields) &&
             data.uid is string &&
             data.uid == userId &&
             data.role == 'referee' &&
             data.status == 'Active' &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 120 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 254 &&
             data.tier is string &&
             data.tier.size() > 0 &&
             data.tier.size() <= 30 &&
             data.photoURL == '' &&
             data.createdAt == request.time &&
             data.avgScore is number && data.avgScore == 0 &&
             data.evaluations is number && data.evaluations == 0 &&
             data.evaluationsCount is number && data.evaluationsCount == 0 &&
             data.totalScoreSum is number && data.totalScoreSum == 0 &&
             data.suggestedTier == '';
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for name lookups, directories)
      allow read: if isAuthenticated();

      // Users can update only their own non-privileged profile fields; role, status, tier, and stats rollups are server-managed
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && isValidOwnerProfileUpdate())
      );

      // Admins can create any user record; Evaluators can create strictly validated new referee records
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isEvaluator() && isValidEvaluatorCreatedReferee(userId))
      );

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // EVALUATIONS COLLECTION
    match /evaluations/{evaluationId} {
      // Admins can read all evaluations
      // Evaluators can read evaluations they conducted (published and unpublished)
      // Referees can ONLY read published evaluations in which they were evaluated
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.evaluatorId == request.auth.uid ||
        (
          (
            resource.data.refereeId == request.auth.uid ||
            (resource.data.refereeIds is list && request.auth.uid in resource.data.refereeIds)
          ) &&
          resource.data.isPublished == true
        )
      );

      // Admins can create evaluations (optional bool isPublished); Evaluators must create unpublished (isPublished == false)
      allow create: if isAuthenticated() && (
        (isAdmin() && (!('isPublished' in request.resource.data) || request.resource.data.isPublished is bool)) ||
        (isEvaluator() &&
         request.resource.data.evaluatorId == request.auth.uid &&
         request.resource.data.isPublished == false)
      );

      // Admins and the conducting Evaluator can update evaluations and toggle publish state without spoofing evaluatorId or publishedBy
      allow update: if isAuthenticated() && (
        (isAdmin() && (!('isPublished' in request.resource.data) || request.resource.data.isPublished is bool)) ||
        (isEvaluator() &&
         resource.data.evaluatorId == request.auth.uid &&
         request.resource.data.evaluatorId == resource.data.evaluatorId &&
         (!('isPublished' in request.resource.data) || request.resource.data.isPublished is bool) &&
         (!('publishedBy' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.publishedBy == null ||
          request.resource.data.publishedBy == request.auth.uid))
      );

      // Only Admins can delete evaluations
      allow delete: if isAdmin();
    }

    // ASSIGNMENTS COLLECTION
    match /assignments/{assignmentId} {
      // Authenticated users can view assignments
      allow read: if isAuthenticated();

      // Only admins and evaluators can manage assignments
      allow write: if isAdmin() || isEvaluator();
    }

    // LOCATIONS COLLECTION
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny any unmatched collections or subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
